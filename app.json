{
  "expo": {
    "name": "Mon Eglise",
    "slug": "ChurchMobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toneglise.app",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application a besoin d'accéder à la caméra pour ajouter la photo de profil d'une nouvelle âme ou d'un membre.",
        "NSPhotoLibraryUsageDescription": "L'application a besoin d'accéder à la galerie photo pour choisir une photo de profil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.toneglise.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Mon Église",
      "shortName": "Mon Église",
      "lang": "fr",
      "scope": "/",
      "themeColor": "#0f172a",
      "backgroundColor": "#f8fafc",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "manifest": "/manifest.json"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à la galerie pour choisir la photo des nouvelles âmes.",
          "cameraPermission": "L'application a besoin d'accéder à la caméra pour prendre la photo des nouvelles âmes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "44b870d1-7a8e-45f9-ab72-c539e170661d"
      }
    }
  }
}
